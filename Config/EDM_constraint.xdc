# ===================================================================
# 1. 主时钟定义 (Clock Definitions)
# ===================================================================

# 1.1 定义外部差分主晶振输入 (提供给 MMCM 的源头)
#create_clock -period 5.000 -name sys_clk_p_in [get_ports clk_p_0]

# 1.2 定义 AD9434 输入的 DCO 采样时钟 (250MSPS -> 周期 4.0ns)
create_clock -period 4.000 -name adc_dco_clk -waveform {0.000 2.000} [get_ports adc_dco_p_0]


# ===================================================================
# 2. 跨时钟域豁免 (Clock Groups / CDC)
# ===================================================================

# 声明系统中的三大核心时钟域为异步关系，防止 Vivado 在跨时钟域 FIFO 处误报时序违例
# - adc_dco_clk: 外部输入的 ADC 时钟
# - main_clk_250m: MMCM 产生的 250MHz 算法时钟
# - pl_clk0: ZYNQ PS 端提供的 100MHz AXI 控制时钟 (基于你的 Block Design 默认命名)
# ===================================================================
# 2. 跨时钟域豁免 (Clock Groups / CDC)
# ===================================================================

# 利用 Vivado 报告出的绝对底层物理引脚 (Pins) 来逆向推断时钟
# 这样可以 100% 免疫 XDC 处理顺序导致的“找不到时钟名”问题
set_clock_groups -asynchronous -group [get_clocks adc_dco_clk] -group [get_clocks -of_objects [get_pins ZYNQ_BlockDesign_i/EDM_Monitor_0/inst/u_global_clk_wiz/inst/mmcme4_adv_inst/CLKOUT0]] -group [get_clocks -of_objects [get_pins {ZYNQ_BlockDesign_i/zynq_ultra_ps_e_0/inst/PS8_i/PLCLK[0]}]]


# ==============================================
# 3. ADC 数据输入延迟约束 (Input Delay)
# ===================================================================

# 基于 AD9434 数据手册 (边沿对齐，上升沿采样)：
# t_SKEW (Max) = 0.380ns
# t_SKEW (Min) = 0.150ns
set_input_delay -clock [get_clocks adc_dco_clk] -max 0.380 [get_ports {adc_data_p_0[*]}]
set_input_delay -clock [get_clocks adc_dco_clk] -min 0.150 [get_ports {adc_data_p_0[*]}]


# ===================================================================
# 4. IDELAYE3 延迟值硬核微调 (Fine-tuning DELAY_VALUE)
# ===================================================================

# 策略：利用 XDC 的 set_property 直接覆盖 Verilog 中设定的 DELAY_VALUE。
# [⚠️注意] 以下设定值为示例 (250)。在 500MHz REFCLK 下，250 大约相当于平移了四分之一个数据周期。
# 你可以在扫眼图测试时，直接在这里修改数值并重新跑 Implementation。

# 批量设置 ADC1 的 12 个数据通道的延迟值
# 路径解析：EDM_Monitor_0 (BD例化名) -> inst (BD自动生成的封装层) -> u_ad9434 (你的模块名) -> gen_adc1_path[*].idelay_inst_adc1
set_property DELAY_VALUE 650 [get_cells {ZYNQ_BlockDesign_i/EDM_Monitor_0/inst/u_ad9434/gen_adc1_path[*].idelay_inst_adc1}]
set_property DELAY_VALUE 650 [get_cells {ZYNQ_BlockDesign_i/EDM_Monitor_0/inst/u_ad9434/gen_adc1_path[*].odelay_inst_adc1}]

# 强制将所有 ADC 数据相关的寄存器放入 IOB
set_property IOB TRUE [get_cells -hierarchical -filter {REF_NAME == IDDRE1 && NAME =~ *u_ad9434*}]

set_false_path -to [get_pins -hierarchical -filter {NAME =~ *IDELAYCTRL_inst/RST}]

set_false_path -to [get_pins -hierarchical -filter {NAME =~ *iddre1_inst1/R}]

set_property PACKAGE_PIN M11 [get_ports {adc_data_p_0[0]}]
set_property PACKAGE_PIN M15 [get_ports {adc_data_p_0[1]}]
set_property PACKAGE_PIN P12 [get_ports {adc_data_p_0[2]}]
set_property PACKAGE_PIN M10 [get_ports {adc_data_p_0[3]}]
set_property PACKAGE_PIN N13 [get_ports {adc_data_p_0[4]}]
set_property PACKAGE_PIN L16 [get_ports {adc_data_p_0[5]}]
set_property PACKAGE_PIN L13 [get_ports {adc_data_p_0[6]}]
set_property PACKAGE_PIN L15 [get_ports {adc_data_p_0[7]}]
set_property PACKAGE_PIN L12 [get_ports {adc_data_p_0[8]}]
set_property PACKAGE_PIN T8 [get_ports {adc_data_p_0[9]}]
set_property PACKAGE_PIN P10 [get_ports {adc_data_p_0[10]}]
set_property PACKAGE_PIN Y4 [get_ports {adc_data_p_0[11]}]

set_property IOSTANDARD LVDS [get_ports {adc_data_p_0[*]}]
set_property IOSTANDARD LVDS [get_ports {adc_data_n_0[*]}]


set_property PACKAGE_PIN AC7 [get_ports emio_spi0_sclk_o_0]
set_property PACKAGE_PIN AA1 [get_ports spi_sdio_0]
set_property PACKAGE_PIN AC2 [get_ports emio_spi0_ss_o_n_0]
set_property IOSTANDARD LVCMOS18 [get_ports emio_spi0_sclk_o_0]
set_property IOSTANDARD LVCMOS18 [get_ports spi_sdio_0]
set_property IOSTANDARD LVCMOS18 [get_ports emio_spi0_ss_o_n_0]

set_property PACKAGE_PIN R10 [get_ports adc_dco_p_0]
set_property PACKAGE_PIN R9 [get_ports adc_dco_n_0]
set_property IOSTANDARD LVDS [get_ports adc_dco_p_0]
set_property IOSTANDARD LVDS [get_ports adc_dco_n_0]


################################################################################
# System Clock (Differential SSTL12)
################################################################################
set_property PACKAGE_PIN AL8 [get_ports clk_p_0]
set_property IOSTANDARD DIFF_SSTL12 [get_ports clk_p_0]
set_property IOSTANDARD DIFF_SSTL12 [get_ports clk_n_0]

################################################################################
# Reset
################################################################################
set_property PACKAGE_PIN F15 [get_ports rst_n_async_0]
set_property IOSTANDARD LVCMOS33 [get_ports rst_n_async_0]

################################################################################
# CDCM61002 Clock Divider Control
################################################################################
set_property PACKAGE_PIN AC1 [get_ports div_param_od0_0]
set_property IOSTANDARD LVCMOS18 [get_ports div_param_od0_0]

set_property PACKAGE_PIN A21 [get_ports power_trig_async_0]
set_property IOSTANDARD LVCMOS33 [get_ports power_trig_async_0]

set_property PACKAGE_PIN A22 [get_ports power_stop_signal_0]
set_property IOSTANDARD LVCMOS33 [get_ports power_stop_signal_0]



